# Expected signer identities, shared by verify.sh, CI and the Kyverno policy
# (policies/kyverno/verify-images.yaml repeats them; keep in sync).
OIDC_ISSUER="https://token.actions.githubusercontent.com"
SOURCE_REPO="github.com/brv52/platform-idp"

# release.yml signs images and SBOM attestations, from main or a v* tag.
RELEASE_IDENTITY_REGEXP='^https://github\.com/brv52/platform-idp/\.github/workflows/release\.yml@refs/(heads/main|tags/v[0-9]+\.[0-9]+\.[0-9]+)$'

# SLSA provenance is signed by the reusable generator workflow, not by us.
SLSA_BUILDER_ID="https://github.com/slsa-framework/slsa-github-generator/.github/workflows/generator_container_slsa3.yml@refs/tags/v2.1.0"
